<%- include('../partials/head',  { title: "Iniciar Sesión" }) %> 
<!--TODO REVISAR POR QUÉ NO RECIBE EL TITLE CORRECTAMENTE-->
<%- include('../partials/header', { usuario: usuario }) %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">Iniciar Sesión</h2>

            <% if (typeof mensaje !== 'undefined' && mensaje) { %>
                <div class="alert alert-danger"><%= mensaje %></div>
            <% } %>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label">Correo Corporativo</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="ejemplo@flotawei.com" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Contraseña</label>
                    <input type="password" class="form-control" id="password" name="password" required>
                </div>

                <div class="mb-3">
                    <input type="checkbox" name="recordar"> Recordar sesión
                </div>


                <button type="submit" class="btn btn-success w-100">Ingresar</button>
            </form>

            <p class="mt-3 text-center">
                ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
            </p>
        </div>
    </div>
</div>

</body>

</html>
