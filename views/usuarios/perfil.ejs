<!---Esto será para un botón visible solo tras el login que permita ver 
el perfil del usuario desde la barra de navegacion-->
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header', { usuario: usuario }) %>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="mb-4">Perfil de Usuario</h2>

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Información del Usuario</h5>
                        <p class="card-text"><strong>Nombre:</strong>
                            <%= usuario.nombre %>
                        </p>
                        <p class="card-text"><strong>Correo Electrónico:</strong>
                            <%= usuario.email %>
                        </p>
                        <p class="card-text"><strong>Rol:</strong>
                            <%= usuario.rol %>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/accesibilidad.js"></script>