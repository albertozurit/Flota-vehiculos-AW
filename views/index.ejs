<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Flota de Vehículos Eléctricos</title>
    <!-- id para poder cambiar dinámicamente -->
    <link rel="stylesheet" href="css/styles.css" id="theme-link">
</head>


<header>
    <img id="logo" src="./images/logo2.png" alt="Logo de la página" width="250">
    <h1>WeiZhu Vehiculos &copy;</h1>
    <!--arreglar para poner con javascript-->
    <a href="english.html" class="lang-switch" hreflang="en" aria-label="Cambiar a la versión en inglés">English</a>

    <!--Ponemos el id para identificarlo de cara al JavaScript TENEMOS QUE CAMBIAR LO QUE DICE EL BOTON CUANDO ESTA EN ALTO CONTRASTE-->
    <button id="contrast-toggle" aria-pressed="false" aria-label="Cambiar a modo alto contraste">
        Alto Contraste
    </button>
<!--TODO REVISAR SI HABRIA QUE USAR MIDDLEWARE-->
    <% if (usuario) { %>
        <div style="display: inline-block; margin-left: 20px;">
            <span style="color: white; margin-right: 10px;">Bienvenido, <%= usuario.nombre || usuario.email %></span>
            <form action="/logout" method="POST" style="display: inline;">
                <button type="submit" style="background-color: #dc3545; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;">
                    Cerrar Sesión
                </button>
            </form>
        </div>
    <% } %>
    <!--script para cambiar el contraste-->
    <!--<script src="js/contrast.js"></script>-->

</header>

<nav aria-label="Menú de navegacion">

    <a href="#inicio" accesskey="i" aria-label="Ir a la seccion de inicio">Inicio</a>
    <a href="#vehiculos" accesskey="v" aria-label="Ir a la seccion de vehiculos">Vehiculos</a>
    <a href="#reservas_form" accesskey="r" aria-label="Ir a la seccion de reservas">Reservas</a>
    <a href="contacto.html" accesskey="c" aria-label="Ir a la seccion de contacto"> Contacto</a>

</nav>

