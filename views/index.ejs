<%# views/index.ejs %>

  <!DOCTYPE html>
  <html lang="es">

  <%- include('partials/head', { title: 'Página Principal' }) %>

    <body>

      <%- include('partials/header', { usuario: usuario }) %>
        <%- include('partials/modal_accesibilidad', { preferencias: preferencias || {} }) %>

          <main>
            <% if (typeof mensaje !=='undefined' && mensaje) { %>
              <div class="container mt-3">
                <div class="alert alert-info">
                  <%= mensaje %>
                </div>
              </div>
              <% } %>

                <!--carrusel-->
                <section class="hero-carousel mb-5">
                  <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">
                    <div class="carousel-indicators">
                      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3"></button>
                      <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4"></button>
                    </div>
                    
                    <div class="carousel-inner">
                      <!-- Slide 1 - Porsche Taycan -->
                      <div class="carousel-item active">
                        <img src="/images/vehiculos/porsche-taycan.jpg" class="d-block w-100" alt="Porsche Taycan">
                        <div class="carousel-caption-custom">
                          <div class="container">
                            <h1 class="display-4 fw-bold mb-3">Porsche Taycan</h1>
                            <p class="lead mb-4">El alma deportiva se vuelve eléctrica. 484 km de rendimiento puro.</p>
                            <div class="d-flex gap-3">
                              <% if (usuario) { %>
                                <a class="btn btn-light btn-lg" href="/vehiculos">Ver vehículos</a>
                              <% } else { %>
                                <a class="btn btn-light btn-lg" href="/login">Iniciar sesión</a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Slide 2 - BMW i4 -->
                      <div class="carousel-item">
                        <img src="/images/vehiculos/bmw-i4.png" class="d-block w-100" alt="BMW i4">
                        <div class="carousel-caption-custom">
                          <div class="container">
                            <h1 class="display-4 fw-bold mb-3">BMW i4</h1>
                            <p class="lead mb-4">Placer de conducir eléctrico. 590 km de autonomía pura.</p>
                            <div class="d-flex gap-3">
                              <% if (usuario) { %>
                                <a class="btn btn-light btn-lg" href="/vehiculos">Explorar flota</a>
                              <% } else { %>
                                <a class="btn btn-light btn-lg" href="/login">Comenzar ahora</a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Slide 3 - Hyundai IONIQ 5 -->
                      <div class="carousel-item">
                        <img src="/images/vehiculos/hyundai-ioniq-5.png" class="d-block w-100" alt="Hyundai IONIQ 5">
                        <div class="carousel-caption-custom">
                          <div class="container">
                            <h1 class="display-4 fw-bold mb-3">Hyundai IONIQ 5</h1>
                            <p class="lead mb-4">Diseño futurista con tecnología avanzada. 481 km de autonomía.</p>
                            <div class="d-flex gap-3">
                              <% if (usuario) { %>
                                <a class="btn btn-light btn-lg" href="/vehiculos">Reservar ahora</a>
                              <% } else { %>
                                <a class="btn btn-light btn-lg" href="/login">Acceder</a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Slide 4 - Polestar 2 -->
                      <div class="carousel-item">
                        <img src="/images/vehiculos/polestar-2.png" class="d-block w-100" alt="Polestar 2">
                        <div class="carousel-caption-custom">
                          <div class="container">
                            <h1 class="display-4 fw-bold mb-3">Polestar 2</h1>
                            <p class="lead mb-4">Elegancia escandinava eléctrica. 470 km de rendimiento sostenible.</p>
                            <div class="d-flex gap-3">
                              <% if (usuario) { %>
                                <a class="btn btn-light btn-lg" href="/vehiculos">Descubrir más</a>
                              <% } else { %>
                                <a class="btn btn-light btn-lg" href="/login">Unirse ahora</a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Slide 5 - Volkswagen ID.4 -->
                      <div class="carousel-item">
                        <img src="/images/vehiculos/volkswagen-id-4.png" class="d-block w-100" alt="Volkswagen ID.4">
                        <div class="carousel-caption-custom">
                          <div class="container">
                            <h1 class="display-4 fw-bold mb-3">Volkswagen ID.4</h1>
                            <p class="lead mb-4">SUV eléctrico inteligente. 520 km de movilidad sostenible.</p>
                            <div class="d-flex gap-3">
                              <% if (usuario) { %>
                                <a class="btn btn-light btn-lg" href="/vehiculos">Ver colección</a>
                              <% } else { %>
                                <a class="btn btn-light btn-lg" href="/login">Empezar</a>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Controles -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Siguiente</span>
                    </button>
                  </div>
                </section>

                <!-- Panel de bienvenida compacto -->
                <div class="container">
                  <section class="p-4 mb-4 bg-light rounded-3 shadow-sm">
                    <div class="text-center">
                      <h2 class="fw-bold page-title">Gestión de Flota WeiZhu</h2>
                      <p class="fs-6 text-muted mb-3">Reserva, gestiona y analiza el estado de tu flota eléctrica</p>
                      <div class="d-flex gap-2 justify-content-center">
                        <% if (usuario) { %>
                          <% if (usuario.rol==='admin' ) { %>
                            <a class="btn btn-primary" href="/admin">Panel de Administración</a>
                            <% } else { %>
                              <a class="btn btn-primary" href="/vehiculos">Ver Vehículos</a>
                              <a class="btn btn-outline-secondary" href="/reservas">Mis Reservas</a>
                              <% } %>
                                <% } else { %>
                                  <a class="btn btn-primary btn-lg" href="/login">Iniciar Sesión</a>
                                  <% } %>
                      </div>
                    </div>
                  </section>
                </div>

                <!-- Características principales -->
                <div class="container">
                  <section class="row g-4 mb-5">
                    <div class="col-md-4">
                      <div class="card h-100 shadow-sm border-0 hover-lift">
                        <div class="card-body text-center p-4">
                          <div class="feature-icon mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-primary" viewBox="0 0 16 16">
                              <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                            </svg>
                          </div>
                          <h5 class="card-title fw-bold">Reservas Inteligentes</h5>
                          <p class="card-text text-muted">Disponibilidad en tiempo real con filtros avanzados por autonomía, plazas y color</p>
                        </div>
                      </div>
                    </div>
                    
                    <div class="col-md-4">
                      <div class="card h-100 shadow-sm border-0 hover-lift">
                        <div class="card-body text-center p-4">
                          <div class="feature-icon mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-success" viewBox="0 0 16 16">
                              <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                              <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                            </svg>
                          </div>
                          <h5 class="card-title fw-bold">Accesibilidad Total</h5>
                          <p class="card-text text-muted">Alto contraste, ajuste de fuente y paletas adaptadas a tus necesidades</p>
                        </div>
                      </div>
                    </div>
                    
                    <div class="col-md-4">
                      <div class="card h-100 shadow-sm border-0 hover-lift">
                        <div class="card-body text-center p-4">
                          <div class="feature-icon mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-warning" viewBox="0 0 16 16">
                              <path d="M9.05.435c-.58-.58-1.52-.58-2.1 0L.436 6.95c-.58.58-.58 1.519 0 2.098l6.516 6.516c.58.58 1.519.58 2.098 0l6.516-6.516c.58-.58.58-1.519 0-2.098L9.05.435zM8 4c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995A.905.905 0 0 1 8 4zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                            </svg>
                          </div>
                          <h5 class="card-title fw-bold">Panel de Control</h5>
                          <p class="card-text text-muted">Gestión completa de vehículos, concesionarios y usuarios con estadísticas</p>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
          </main>


          <script>
            const serverPrefs = JSON.stringify(preferencias || {});

            if (serverPrefs.contraste) sessionStorage.setItem('altoContraste', 'true');
            if (serverPrefs.daltonismo) sessionStorage.setItem('daltonismo', 'true');
            if (serverPrefs.fontSize) sessionStorage.setItem('fontSize', serverPrefs.fontSize);
          </script>
          <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
          <script>
            window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
            window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
          </script>
          <script src="/js/atajos.js"></script>
          <script src="/js/accesibilidad.js"></script>
          <%- include('partials/footer') %>

    </body>

  </html>