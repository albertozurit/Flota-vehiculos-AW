<header>
    <!-- Navegación única -->
    <nav class="main-nav fixed-top" aria-label="Navegación principal">
        <div class="container-fluid">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Logo y Enlaces de Navegación juntos -->
                <div class="d-flex align-items-center">
                    <!-- Logo -->
                    <a class="logo-marca" href="/">
                        <img src="/images/LogoRueda.png" alt="WeiZhu" width="60" height="60">
                    </a>

                    <!-- Navigation Links -->
                    <ul class="nav-list">
                        <!-- Inicio - Siempre visible -->
                        <li class="nav-item">
                            <a class="nav-link" href="/" accesskey="i">Inicio</a>
                        </li>

                        <% if (usuario && usuario.rol==='empleado' ) { %>
                            <!-- Vehículos disponibles - Para empleados -->
                            <li class="nav-item">
                                <a class="nav-link" href="/vehiculos" accesskey="v">Vehículos disponibles</a>
                            </li>

                            <!-- Mis reservas - Para empleados -->
                            <li class="nav-item">
                                <a class="nav-link" href="/reservas" accesskey="h">Mis reservas</a>
                            </li>
                            <% } %>

                                <% if (usuario && usuario.rol==='admin' ) { %>
                                    <!-- Vehículos disponibles - Para admin -->
                                    <li class="nav-item">
                                        <a class="nav-link" href="/vehiculos" accesskey="v">Vehículos disponibles</a>
                                    </li>

                                    <!-- Administración - Solo admin -->
                                    <li class="nav-item">
                                        <a class="nav-link" href="/admin" accesskey="a">Administración</a>
                                    </li>
                                    <% } %>
                    </ul>
                </div>

                <!-- Right Side Actions -->
                <div class="nav-actions">
                    <!-- Accesibilidad - Siempre visible -->
                    <button class="btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#modalAccesibilidad"
                        aria-label="Accesibilidad" title="Accesibilidad">
                        <img src="/images/universal-access-circle.svg" alt="Accesibilidad" width="20" height="20">
                    </button>

                    <% if (usuario) { %>
                        <!-- Perfil de usuario - Visible tras login -->
                        <button class="btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#modalPerfil"
                            aria-label="Perfil" title="Mi Perfil">
                            <img src="/images/person-circle.svg" alt="Perfil" width="20" height="20">
                        </button>

                        <!-- Cerrar sesión - Disponible tras login -->
                        <form action="/logout" method="POST" class="m-0">
                            <button type="submit" class="logout-btn">Cerrar sesión</button>
                        </form>
                        <% } else { %>
                            <!-- Iniciar sesión -->
                            <a class="btn-icon" href="/login" aria-label="Iniciar sesión" title="Iniciar sesión">
                                <img src="/images/person-circle.svg" alt="Login" width="20" height="20">
                            </a>
                            <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Modal Accesibilidad (siempre disponible) -->
    <%- include('modal_accesibilidad', { preferencias: (typeof preferencias !=='undefined' ? preferencias : {}) }) %>

        <!-- Modal Carga JSON (siempre disponible) -->
        <div class="modal fade" id="modalCargaJSON" tabindex="-1" aria-labelledby="modalCargaJSONLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="POST" action="/admin/carga-json">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalCargaJSONLabel">Carga inicial desde JSON</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>Se leerá el archivo <code>bd_vacia.json</code> de la raíz del proyecto.</p>
                        <p class="text-warning mb-0">Asegúrate de que la base de datos está vacía.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Cargar datos</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Perfil (solo tras login) -->
        <% if (usuario) { %>
            <div class="modal fade" id="modalPerfil" tabindex="-1" aria-labelledby="modalPerfilLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalPerfilLabel">Perfil</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="d-flex align-items-center gap-3">
                                <img src="/images/person-circle.svg" alt="Usuario" width="40" height="40">
                                <div>
                                    <div class="fw-semibold">
                                        <%= usuario.nombre || usuario.email %>
                                    </div>
                                    <div class="text-muted">Rol: <%= usuario.rol %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="/perfil" class="btn btn-primary">Ver perfil completo</a>
                            <form action="/logout" method="POST">
                                <button class="btn btn-outline-danger">Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

</header>