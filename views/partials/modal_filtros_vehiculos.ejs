<!-- Modal de Filtros de Vehículos TODO actualizar sin recargar página--> 
<div class="modal fade" id="modalFiltros" tabindex="-1" aria-labelledby="modalFiltrosLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFiltrosLabel">Filtrar vehículos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="filtrosForm" class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label">Autonomía mínima (km)</label>
                        <input type="number" min="0" step="1" name="autonomia_min" class="form-control" 
                            onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                            placeholder="Ej: 300"
                            value="<%= (typeof filtros!=='undefined' && filtros.autonomia_min) || '' %>">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Número de plazas</label>
                        <input type="number" min="1" max="9" step="1" name="plazas" class="form-control"
                            onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                            placeholder="Ej: 5"
                            value="<%= (typeof filtros!=='undefined' && filtros.plazas) || '' %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Color</label>
                        <input type="text" name="color" class="form-control"
                            placeholder="Ej: Negro, Blanco, Azul"
                            value="<%= (typeof filtros!=='undefined' && filtros.color) || '' %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ciudad</label>
                        <input type="text" name="ciudad" class="form-control"
                            placeholder="Ej: Madrid, Barcelona, Tenerife"
                            value="<%= (typeof filtros!=='undefined' && filtros.ciudad) || '' %>">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="limpiarFiltros" class="btn btn-outline-secondary">Limpiar</button>
                <button type="submit" form="filtrosForm" class="btn btn-primary" data-bs-dismiss="modal">Aplicar</button>
            </div>
        </div>
    </div>
</div>
<script>
    (function() {
        function initModalFiltros() {
            const form = document.getElementById('filtrosForm');
            const limpiar = document.getElementById('limpiarFiltros');
            const modal = document.getElementById('modalFiltros');
            
            if (!form || !limpiar || !modal) {
                setTimeout(initModalFiltros, 100);
                return;
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                
                // Cerrar modal primero
                const bsModal = bootstrap.Modal.getInstance(modal);
                if (bsModal) bsModal.hide();
                
                const params = new URLSearchParams(new FormData(form));
                
                // Hacer petición AJAX
                fetch('/vehiculos?' + params.toString(), {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    // Crear un documento temporal para parsear el HTML
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // Extraer el contenido del main
                    const newMain = doc.querySelector('main');
                    const currentMain = document.querySelector('main');
                    
                    if (newMain && currentMain) {
                        currentMain.innerHTML = newMain.innerHTML;
                        // Re-inicializar scripts si es necesario
                        initModalFiltros();
                    }
                })
                .catch(error => {
                    console.error('Error al aplicar filtros:', error);
                    alert('Error al aplicar filtros. Intenta de nuevo.');
                });
            });

            limpiar.addEventListener('click', function () {
                // Limpiar filtros con AJAX
                fetch('/vehiculos', {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newMain = doc.querySelector('main');
                    const currentMain = document.querySelector('main');
                    
                    if (newMain && currentMain) {
                        currentMain.innerHTML = newMain.innerHTML;
                        initModalFiltros();
                    }
                })
                .catch(error => {
                    console.error('Error al limpiar filtros:', error);
                    alert('Error al limpiar filtros. Intenta de nuevo.');
                });
            });
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initModalFiltros);
        } else {
            initModalFiltros();
        }
    })();
</script>
