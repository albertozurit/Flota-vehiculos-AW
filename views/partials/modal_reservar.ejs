<!-- Modal para reservar: el contenido del formulario se inyecta vía AJAX -->
<div class="modal fade" id="reservarModal" tabindex="-1" aria-labelledby="reservarModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content shadow-sm rounded-3">
      <div class="modal-header border-0 pb-0">
        <h4 class="modal-title fw-bold" id="reservarModalLabel">Reservar vehículo</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body pt-2" id="reservarModalContent">
        <!-- Aquí se inyecta el HTML del formulario cargado desde /reservas/nuevo/:id -->
        <div class="text-center p-4 text-muted">Cargando...</div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Script cliente para inyección en modal -->
<!-- Cargar Bootstrap JS (bundle incluye Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/reservar.js"></script>
