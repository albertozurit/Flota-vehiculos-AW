<!-- Tarjeta Individual de Vehículo -->
<div class="col">
    <div class="card h-100 shadow-sm hover-card">
        <!-- Imagen -->
        <div class="card-img-container">
            <% if (vehiculo.imagen) { %>
                <img src="<%= vehiculo.imagen %>" class="card-img-top"
                    alt="<%= vehiculo.marca %> <%= vehiculo.modelo %>" onerror="this.src='/images/no-image.png'">
                <% } else { %>
                    <img src="/images/no-image.png" class="card-img-top" alt="Sin imagen">
                    <% } %>
        </div>

        <!-- Contenido -->
        <div class="card-body">
            <h5 class="card-title">
                <%= vehiculo.marca %>
                    <%= vehiculo.modelo %>
            </h5>
            <p class="card-text text-muted small mb-2">
                <strong>Matrícula:</strong>
                <%= vehiculo.matricula %>
            </p>

            <div class="vehicle-details">
                <div class="detail-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        class="bi bi-calendar" viewBox="0 0 16 16">
                        <path
                            d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                    </svg>
                    <%= vehiculo.anio_matriculacion || '-' %>
                </div>
                <div class="detail-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        class="bi bi-people" viewBox="0 0 16 16">
                        <path
                            d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816zM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275zM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" />
                    </svg>
                    <%= vehiculo.numero_plazas || '-' %> plazas
                </div>
                <div class="detail-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        class="bi bi-battery-charging" viewBox="0 0 16 16">
                        <path
                            d="M9.585 2.568a.5.5 0 0 1 .226.58L8.677 6.832h1.99a.5.5 0 0 1 .364.843l-5.334 5.667a.5.5 0 0 1-.842-.49L5.99 9.167H4a.5.5 0 0 1-.364-.843l5.333-5.667a.5.5 0 0 1 .616-.09z" />
                        <path
                            d="M2 4h4.332l-.94 1H2a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2.38l-.308 1H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
                        <path
                            d="M2 6h2.45L2.908 7.639A1.5 1.5 0 0 0 3.313 10H2V6zm8.595-2-.308 1H12a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H9.276l-.942 1H12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.405z" />
                        <path
                            d="M12 10h-1.783l1.542-1.639c.097-.103.178-.218.241-.34V10zm0-3.354V6h-.646a1.5 1.5 0 0 1 .646.646zM16 8a1.5 1.5 0 0 1-1.5 1.5v-3A1.5 1.5 0 0 1 16 8z" />
                    </svg>
                    <%= vehiculo.autonomia_km || '-' %> km
                </div>
                <div class="detail-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        class="bi bi-palette" viewBox="0 0 16 16">
                        <path
                            d="M8 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm4 3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM5.5 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" />
                        <path
                            d="M16 8c0 3.15-1.866 2.585-3.567 2.07C11.42 9.763 10.465 9.473 10 10c-.603.683-.475 1.819-.351 2.92C9.826 14.495 9.996 16 8 16a8 8 0 1 1 8-8zm-8 7c.611 0 .654-.171.655-.176.078-.146.124-.464.07-1.119-.014-.168-.037-.37-.061-.591-.052-.464-.112-1.005-.118-1.462-.01-.707.083-1.61.704-2.314.369-.417.845-.578 1.272-.618.404-.038.812.026 1.16.104.343.077.702.186 1.025.284l.028.008c.346.105.658.199.953.266.653.148.904.083.991.024C14.717 9.38 15 9.161 15 8a7 7 0 1 0-7 7z" />
                    </svg>
                    <%= vehiculo.color || '-' %>
                </div>
            </div>

            <!-- Badge de estado -->
            <div class="mt-3">
                <% if (vehiculo.estado==='disponible' ) { %>
                    <span class="badge bg-success w-100 py-2"><i class="bi bi-check-circle me-1"></i>Disponible</span>
                    <% } else if (vehiculo.estado==='reservado' ) { %>
                        <span class="badge bg-warning w-100 py-2"><i class="bi bi-clock me-1"></i>Reservado</span>
                        <% } else { %>
                            <span class="badge bg-danger w-100 py-2"><i
                                    class="bi bi-tools me-1"></i>Mantenimiento</span>
                            <% } %>
            </div>
        </div>

        <!-- Acciones -->
        <div class="card-footer bg-light">
            <% if (usuario && usuario.rol==='admin' ) { %>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal"
                        data-bs-target="#modalEditarVehiculo" data-id="<%= vehiculo.id %>"
                        data-matricula="<%= vehiculo.matricula || '' %>" data-marca="<%= vehiculo.marca || '' %>"
                        data-modelo="<%= vehiculo.modelo || '' %>" data-anio="<%= vehiculo.anio_matriculacion || '' %>"
                        data-plazas="<%= vehiculo.numero_plazas || '' %>"
                        data-autonomia="<%= vehiculo.autonomia_km || '' %>" data-color="<%= vehiculo.color || '' %>"
                        data-imagen="<%= vehiculo.imagen || '' %>">
                        <i class="bi bi-pencil"></i> Editar
                    </button>
                    <form action="/vehiculos/<%= vehiculo.id %>/eliminar" method="POST">
                        <button type="submit" class="btn btn-sm btn-danger w-100"
                            onclick="return confirm('¿Seguro que quieres eliminar este vehículo?')">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </form>
                </div>
                <% } else { %>
                    <div class="d-grid">
                        <% if (vehiculo.estado==='disponible' ) { %>
                            <button class="btn btn-sm btn-primary reservar-btn" data-bs-toggle="modal"
                                data-bs-target="#reservarModal" data-id="<%= vehiculo.id %>">
                                <i class="bi bi-calendar-check"></i> Reservar
                            </button>
                            <% } else { %>
                                <button class="btn btn-sm btn-secondary" disabled>No disponible</button>
                                <% } %>
                    </div>
                    <% } %>
        </div>
    </div>
</div>