<%- include('../partials/head', { title: 'Nuevo Vehículo' }) %>

    <body>
        <%- include('../partials/header', { usuario: usuario }) %>

            <main class="container mt-5 pt-3">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card shadow-sm">
                            <div class="card-header bg-primary text-white">
                                <h2 class="h4 mb-0"><i class="bi bi-car-front me-2"></i>Crear Nuevo Vehículo</h2>
                            </div>
                            <div class="card-body p-4">
                                <% if (mensaje) { %>
                                    <div class="alert alert-danger">
                                        <%= mensaje %>
                                    </div>
                                    <% } %>

                                        <form action="/admin/vehiculos/nuevo" method="POST"
                                            enctype="multipart/form-data">

                                            <div class="mb-3">
                                                <label for="matricula" class="form-label">Matrícula *</label>
                                                <input type="text" class="form-control" id="matricula" name="matricula"
                                                    required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="marca" class="form-label">Marca *</label>
                                                <input type="text" class="form-control" id="marca" name="marca"
                                                    required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="modelo" class="form-label">Modelo *</label>
                                                <input type="text" class="form-control" id="modelo" name="modelo"
                                                    required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="anio_matriculacion" class="form-label">Año de
                                                    matriculación</label>
                                                <input type="number" class="form-control" id="anio_matriculacion"
                                                    name="anio_matriculacion" min="1900" max="2100">
                                            </div>

                                            <div class="mb-3">
                                                <label for="numero_plazas" class="form-label">Número de plazas</label>
                                                <input type="number" class="form-control" id="numero_plazas"
                                                    name="numero_plazas" min="1">
                                            </div>

                                            <div class="mb-3">
                                                <label for="autonomia_km" class="form-label">Autonomía (km)</label>
                                                <input type="number" class="form-control" id="autonomia_km"
                                                    name="autonomia_km" min="0">
                                            </div>

                                            <div class="mb-3">
                                                <label for="color" class="form-label">Color</label>
                                                <input type="text" class="form-control" id="color" name="color">
                                            </div>

                                            <div class="mb-3">
                                                <label for="imagen" class="form-label">
                                                    <i class="bi bi-camera"></i> Foto del vehículo
                                                </label>
                                                <input type="file" class="form-control" id="imagen" name="imagen"
                                                    accept="image/jpeg,image/png,image/gif,image/webp">
                                                <small class="text-muted">Formatos permitidos: JPEG, PNG, GIF, WebP.
                                                    Máximo 5MB.</small>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i>
                                                    Crear Vehículo</button>
                                                <a href="/admin/vehiculos" class="btn btn-secondary"><i
                                                        class="bi bi-x-circle"></i> Cancelar</a>
                                            </div>
                                        </form>
                            </div>
                        </div>
                    </div>
                </div>
            </main>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
                window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
            </script>
            <script src="/js/atajos.js"></script>
            <script src="/js/accesibilidad.js"></script>

            <%- include('../partials/footer', { usuario: usuario }) %>

    </body>

    </html>