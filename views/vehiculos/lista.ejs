<%- include('../partials/head') %>

    <div class="container mt-5">
        <h2 class="mb-4">Lista de Vehículos</h2>

        <% if (mensaje) { %>
            <div class="alert alert-danger">
                <%= mensaje %>
            </div>
            <% } %>

                <% if (usuario && usuario.rol==='admin' ) { %>
                    <a href="/admin/vehiculos/nuevo" class="btn btn-primary mb-3"><i class="bi bi-plus-circle"></i>
                        Crear Nuevo Vehículo</a>
                    <% } %>

                        <% if (vehiculos.length===0) { %>
                            <div class="alert alert-info">
                                No hay vehículos registrados en la plataforma.
                            </div>
                            <% } else { %>
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Marca</th>
                                            <th>Modelo</th>
                                            <th>Matrícula</th>
                                            <th>Año</th>
                                            <th>Estado</th>
                                            <% if (usuario && usuario.rol==='admin' ) { %>
                                                <th>Acciones</th>
                                                <% } else { %>
                                                    <!-- AÑADIMOS LA COLUMNA DE RESERVA PARA USUARIOS NORMALES -->
                                                    <th>Reserva</th>
                                                    <% } %>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% vehiculos.forEach(vehiculo=> { %>
                                            <tr>
                                                <td>
                                                    <%= vehiculo.id %>
                                                </td>
                                                <td>
                                                    <%= vehiculo.marca %>
                                                </td>
                                                <td>
                                                    <%= vehiculo.modelo %>
                                                </td>
                                                <td>
                                                    <%= vehiculo.matricula %>
                                                </td>
                                                <td>
                                                    <%= vehiculo.anio_matriculacion || '' %>
                                                </td>
                                                <td>
                                                    <% if (vehiculo.estado==='disponible' ) { %>
                                                        <span class="badge bg-success">Disponible</span>
                                                        <% } else if (vehiculo.estado==='reservado' ) { %>
                                                            <span class="badge bg-warning">Reservado</span>
                                                            <% } else { %>
                                                                <span class="badge bg-danger">Mantenimiento</span>
                                                                <% } %>
                                                </td>

                                                <!-- LÓGICA DE ACCIONES/RESERVA (ESTA SECCIÓN HA SIDO MODIFICADA) -->
                                                <% if (usuario && usuario.rol==='admin' ) { %>
                                                    <td>
                                                        <!-- Acciones de Admin (Editar/Eliminar) -->
                                                        <button type="button" class="btn btn-sm btn-warning"
                                                            data-bs-toggle="modal" data-bs-target="#modalEditarVehiculo"
                                                            data-id="<%= vehiculo.id %>"
                                                            data-matricula="<%= vehiculo.matricula || '' %>"
                                                            data-marca="<%= vehiculo.marca || '' %>"
                                                            data-modelo="<%= vehiculo.modelo || '' %>"
                                                            data-anio="<%= vehiculo.anio_matriculacion || '' %>"
                                                            data-plazas="<%= vehiculo.numero_plazas || '' %>"
                                                            data-autonomia="<%= vehiculo.autonomia_km || '' %>"
                                                            data-color="<%= vehiculo.color || '' %>"
                                                            data-imagen="<%= vehiculo.imagen || '' %>">Editar</button>
                                                        <form action="/vehiculos/<%= vehiculo.id %>/eliminar"
                                                            method="POST" style="display:inline;">
                                                            <button type="submit" class="btn btn-sm btn-danger"
                                                                onclick="return confirm('¿Seguro que quieres eliminar este vehículo?')">
                                                                Eliminar</button>
                                                        </form>
                                                    </td>
                                                    <% } else { %>
                                                        <td>
                                                            <!-- BOTÓN DE RESERVA PARA USUARIOS AUTENTICADOS -->
                                                            <% if (vehiculo.estado==='disponible' ) { %>
                                                                <button type="button"
                                                                    class="btn btn-sm btn-primary reservar-btn"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#reservarModal"
                                                                    data-id="<%= vehiculo.id %>">
                                                                    <i class="fas fa-calendar-alt"></i> Reservar
                                                                </button>
                                                                <% } else { %>
                                                                    <button class="btn btn-sm btn-secondary" disabled>No
                                                                        disponible</button>
                                                                    <% } %>
                                                        </td>
                                                        <% } %>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                                <% } %>
    </div>

    <%- include('../partials/modal_reservar') %>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
            window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
        </script>
        <script src="/js/atajos.js"></script>
        <script src="/js/accesibilidad.js"></script>
        <%- include('../partials/footer', { usuario: usuario }) %>

            </body>

            </html>