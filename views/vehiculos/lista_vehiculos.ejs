<%- include('../partials/head', { title: 'Vehículos Disponibles' }) %>
    <%- include('../partials/header', { usuario: usuario }) %>

        <main class="container mt-5 pt-3">
            <h2 class="mb-4 page-title">Vehículos Disponibles</h2>

            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                    data-bs-target="#modalFiltros">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        class="bi bi-funnel me-1" viewBox="0 0 16 16">
                        <path
                            d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2h-11z" />
                    </svg>
                    Filtros
                </button>
            </div>

            <!-- Modal de Filtros -->
            <div class="modal fade" id="modalFiltros" tabindex="-1" aria-labelledby="modalFiltrosLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalFiltrosLabel">Filtrar vehículos</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <form id="filtrosForm" class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label">Autonomía mínima (km)</label>
                                    <input type="number" min="0" name="autonomia_min" class="form-control"
                                        value="<%= (typeof filtros!=='undefined' && filtros.autonomia_min) || '' %>">
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Número de plazas</label>
                                    <input type="number" min="1" name="plazas" class="form-control"
                                        value="<%= (typeof filtros!=='undefined' && filtros.plazas) || '' %>">
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Color</label>
                                    <input type="text" name="color" class="form-control"
                                        value="<%= (typeof filtros!=='undefined' && filtros.color) || '' %>">
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Ciudad</label>
                                    <input type="text" name="ciudad" class="form-control"
                                        value="<%= (typeof filtros!=='undefined' && filtros.ciudad) || '' %>">
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Inicio</label>
                                    <input type="datetime-local" name="inicio" class="form-control"
                                        value="<%= (typeof filtros!=='undefined' && filtros.inicio) || '' %>">
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label">Fin</label>
                                    <input type="datetime-local" name="fin" class="form-control"
                                        value="<%= (typeof filtros!=='undefined' && filtros.fin) || '' %>">
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" id="limpiarFiltros" class="btn btn-outline-secondary">Limpiar</button>
                            <button type="submit" form="filtrosForm" class="btn btn-primary"
                                data-bs-dismiss="modal">Aplicar</button>
                        </div>
                    </div>
                </div>
            </div>

            <% if (mensaje) { %>
                <div class="alert alert-danger">
                    <%= mensaje %>
                </div>
                <% } %>

                    <% if (usuario && usuario.rol==='admin' ) { %>
                        <a href="/vehiculos/nuevo" class="btn btn-primary mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                class="bi bi-plus-circle me-1" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                                <path
                                    d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                            </svg>
                            Crear Nuevo Vehículo
                        </a>
                        <% } %>

                            <% if (vehiculos.length===0) { %>
                                <div class="alert alert-info">
                                    No hay vehículos disponibles con los filtros seleccionados.
                                </div>
                                <% } else { %>
                                    <!-- Grid de Tarjetas -->
                                    <div id="vehiculosGrid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                                        <% vehiculos.forEach(vehiculo=> { %>
                                            <div class="col">
                                                <div class="card h-100 shadow-sm hover-card">
                                                    <!-- Imagen -->
                                                    <div class="card-img-container">
                                                        <img src="/vehiculos/<%= vehiculo.id %>/imagen"
                                                            class="card-img-top"
                                                            alt="<%= vehiculo.marca %> <%= vehiculo.modelo %>"
                                                            onerror="this.src='/images/no-image.png'">
                                                    </div>

                                                    <!-- Contenido -->
                                                    <div class="card-body">
                                                        <h5 class="card-title">
                                                            <%= vehiculo.marca %>
                                                                <%= vehiculo.modelo %>
                                                        </h5>
                                                        <p class="card-text text-muted small mb-2">
                                                            <strong>Matrícula:</strong>
                                                            <%= vehiculo.matricula %>
                                                        </p>

                                                        <div class="vehicle-details">
                                                            <div class="detail-item">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" fill="currentColor"
                                                                    class="bi bi-calendar" viewBox="0 0 16 16">
                                                                    <path
                                                                        d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                                                                </svg>
                                                                <%= vehiculo.anio_matriculacion || '-' %>
                                                            </div>
                                                            <div class="detail-item">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" fill="currentColor" class="bi bi-people"
                                                                    viewBox="0 0 16 16">
                                                                    <path
                                                                        d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816zM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275zM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" />
                                                                </svg>
                                                                <%= vehiculo.numero_plazas || '-' %> plazas
                                                            </div>
                                                            <div class="detail-item">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" fill="currentColor"
                                                                    class="bi bi-battery-charging" viewBox="0 0 16 16">
                                                                    <path
                                                                        d="M9.585 2.568a.5.5 0 0 1 .226.58L8.677 6.832h1.99a.5.5 0 0 1 .364.843l-5.334 5.667a.5.5 0 0 1-.842-.49L5.99 9.167H4a.5.5 0 0 1-.364-.843l5.333-5.667a.5.5 0 0 1 .616-.09z" />
                                                                    <path
                                                                        d="M2 4h4.332l-.94 1H2a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2.38l-.308 1H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
                                                                    <path
                                                                        d="M2 6h2.45L2.908 7.639A1.5 1.5 0 0 0 3.313 10H2V6zm8.595-2-.308 1H12a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H9.276l-.942 1H12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.405z" />
                                                                    <path
                                                                        d="M12 10h-1.783l1.542-1.639c.097-.103.178-.218.241-.34V10zm0-3.354V6h-.646a1.5 1.5 0 0 1 .646.646zM16 8a1.5 1.5 0 0 1-1.5 1.5v-3A1.5 1.5 0 0 1 16 8z" />
                                                                </svg>
                                                                <%= vehiculo.autonomia_km || '-' %> km
                                                            </div>
                                                            <div class="detail-item">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" fill="currentColor"
                                                                    class="bi bi-palette" viewBox="0 0 16 16">
                                                                    <path
                                                                        d="M8 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm4 3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM5.5 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" />
                                                                    <path
                                                                        d="M16 8c0 3.15-1.866 2.585-3.567 2.07C11.42 9.763 10.465 9.473 10 10c-.603.683-.475 1.819-.351 2.92C9.826 14.495 9.996 16 8 16a8 8 0 1 1 8-8zm-8 7c.611 0 .654-.171.655-.176.078-.146.124-.464.07-1.119-.014-.168-.037-.37-.061-.591-.052-.464-.112-1.005-.118-1.462-.01-.707.083-1.61.704-2.314.369-.417.845-.578 1.272-.618.404-.038.812.026 1.16.104.343.077.702.186 1.025.284l.028.008c.346.105.658.199.953.266.653.148.904.083.991.024C14.717 9.38 15 9.161 15 8a7 7 0 1 0-7 7z" />
                                                                </svg>
                                                                <%= vehiculo.color || '-' %>
                                                            </div>
                                                        </div>

                                                        <!-- Badge de estado -->
                                                        <div class="mt-3">
                                                            <% if (vehiculo.estado==='disponible' ) { %>
                                                                <span class="badge bg-success w-100 py-2">✓
                                                                    Disponible</span>
                                                                <% } else if (vehiculo.estado==='reservado' ) { %>
                                                                    <span class="badge bg-warning w-100 py-2">⚠
                                                                        Reservado</span>
                                                                    <% } else { %>
                                                                        <span class="badge bg-danger w-100 py-2">⚙
                                                                            Mantenimiento</span>
                                                                        <% } %>
                                                        </div>
                                                    </div>

                                                    <!-- Acciones -->
                                                    <div class="card-footer bg-light">
                                                        <% if (usuario && usuario.rol==='admin' ) { %>
                                                            <div class="d-grid gap-2">
                                                                <a href="/vehiculos/<%= vehiculo.id %>/editar/"
                                                                    class="btn btn-sm btn-warning">
                                                                    <i class="bi bi-pencil"></i> Editar
                                                                </a>
                                                                <form action="/vehiculos/<%= vehiculo.id %>/eliminar"
                                                                    method="POST">
                                                                    <button type="submit"
                                                                        class="btn btn-sm btn-danger w-100"
                                                                        onclick="return confirm('¿Seguro que quieres eliminar este vehículo?')">
                                                                        <i class="bi bi-trash"></i> Eliminar
                                                                    </button>
                                                                </form>
                                                            </div>
                                                            <% } else { %>
                                                                <div class="d-grid">
                                                                    <% if (vehiculo.estado==='disponible' ) { %>
                                                                        <button
                                                                            class="btn btn-sm btn-primary reservar-btn"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#reservarModal"
                                                                            data-id="<%= vehiculo.id %>">
                                                                            <i class="bi bi-calendar-check"></i>
                                                                            Reservar
                                                                        </button>
                                                                        <% } else { %>
                                                                            <button class="btn btn-sm btn-secondary"
                                                                                disabled>No disponible</button>
                                                                            <% } %>
                                                                </div>
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% } %>

        </main>

        <%- include('../partials/modal_reservar') %>

            <script>
                const form = document.getElementById('filtrosForm');
                const limpiar = document.getElementById('limpiarFiltros');
                const grid = document.getElementById('vehiculosGrid');

                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const params = new URLSearchParams(new FormData(form));
                    $.ajax({
                        url: '/vehiculos?' + params.toString(),
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        success: function (html) {
                            const tmp = document.createElement('div');
                            tmp.innerHTML = html;
                            const newGrid = tmp.querySelector('#vehiculosGrid');
                            if (newGrid) grid.innerHTML = newGrid.innerHTML;
                        },
                        error: function () { alert('Error al filtrar vehículos'); }
                    });
                });

                limpiar.addEventListener('click', function () {
                    form.reset();
                    form.dispatchEvent(new Event('submit'));
                });
            </script>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
                window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
            </script>
            <script src="/js/atajos.js"></script>
            <script src="/js/accesibilidad.js"></script>

            <%- include('../partials/footer', { usuario: usuario }) %>

                </body>

                </html>