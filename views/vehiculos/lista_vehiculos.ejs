<%- include('../partials/head', { title: 'Vehículos Disponibles' }) %>
<%- include('../partials/header', { usuario: usuario }) %>

<main class="container mt-5 pt-3">
    <h2 class="mb-4 page-title">Vehículos Disponibles</h2>

    <!-- Botón de filtros -->
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalFiltros">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                class="bi bi-funnel me-1" viewBox="0 0 16 16">
                <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2h-11z" />
            </svg>
            Filtros
        </button>
    </div>

    <!-- Mensaje de error -->
    <% if (mensaje) { %>
        <div class="alert alert-danger"><%= mensaje %></div>
    <% } %>


    <!-- Lista de vehículos -->
    <% if (vehiculos.length===0) { %>
        <div id="vehiculosGrid" class="text-center py-5 my-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-car-front text-muted mb-4 d-block mx-auto" viewBox="0 0 16 16">
                <path d="M4 9a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm10 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6 8a1 1 0 0 0 0 2h4a1 1 0 1 0 0-2H6ZM4.862 4.276 3.906 6.19a.51.51 0 0 0 .497.731c.91-.073 2.35-.17 3.597-.17 1.247 0 2.688.097 3.597.17a.51.51 0 0 0 .497-.731l-.956-1.913A.5.5 0 0 0 10.691 4H5.309a.5.5 0 0 0-.447.276Z"/>
                <path d="M2.52 3.515A2.5 2.5 0 0 1 4.82 2h6.362c1 0 1.904.596 2.298 1.515l.792 1.848c.075.175.21.319.38.404.5.25.855.715.965 1.262l.335 1.679c.033.161.049.325.049.49v.413c0 .814-.39 1.543-1 1.997V13.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-1.338c-1.292.048-2.745.088-4 .088s-2.708-.04-4-.088V13.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-1.892c-.61-.454-1-1.183-1-1.997v-.413a2.5 2.5 0 0 1 .049-.49l.335-1.68c.11-.546.465-1.012.964-1.261a.807.807 0 0 0 .381-.404l.792-1.848ZM4.82 3a1.5 1.5 0 0 0-1.379.91l-.792 1.847a1.8 1.8 0 0 1-.853.904.807.807 0 0 0-.43.564L1.03 8.904a1.5 1.5 0 0 0-.03.294v.413c0 .796.62 1.448 1.408 1.484 1.555.07 3.786.155 5.592.155 1.806 0 4.037-.084 5.592-.155A1.479 1.479 0 0 0 15 9.611v-.413c0-.099-.01-.197-.03-.294l-.335-1.68a.807.807 0 0 0-.43-.563 1.807 1.807 0 0 1-.853-.904l-.792-1.848A1.5 1.5 0 0 0 11.18 3H4.82Z"/>
            </svg>
            <h4 class="text-muted mb-3">No hay vehículos disponibles</h4>
            <p class="text-muted">En este momento no hay vehículos que coincidan con los filtros seleccionados.</p>
        </div>
    <% } else { %>
        <% 
        let concesionarioActual = null;
        const esAdmin = usuario && usuario.rol === 'admin';
        const esEmpleado = usuario && usuario.rol === 'empleado';
        
        vehiculos.forEach((vehiculo, index) => { 
            // Mostrar separador de concesionario para admin (cuando cambia) o empleado (solo una vez al inicio)
            const mostrarSeparador = (esAdmin && vehiculo.concesionario_nombre !== concesionarioActual) || 
                                    (esEmpleado && index === 0);
            
            if (mostrarSeparador) {
                concesionarioActual = vehiculo.concesionario_nombre;
                
                // Cerrar grid anterior si no es el primero
                if (index > 0) { %>
                    </div>
                <% } %>
                
                <!-- Separador de concesionario -->
                <div class="mb-4 mt-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white px-3 py-2 rounded-start">
                            <i class="bi bi-building-fill me-2"></i><strong><%= concesionarioActual %></strong>
                        </div>
                        <div class="bg-light px-3 py-2 border border-start-0 rounded-end flex-grow-1">
                            <small class="text-muted"><i class="bi bi-geo-alt-fill me-1"></i><%= vehiculo.concesionario_ciudad || '' %></small>
                        </div>
                    </div>
                </div>
                
                <!-- Nuevo grid -->
                <div id="vehiculosGrid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            <% } else if (index === 0) { %>
                <!-- Primer grid (sin rol o cliente) -->
                <div id="vehiculosGrid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            <% } %>
            
            <%- include('tarjeta_vehiculo', { vehiculo: vehiculo, usuario: usuario }) %>
        <% }); %>
        </div>
    <% } %>
</main>

<!-- Modales -->
<%- include('../partials/modal_reservar') %>
<%- include('../partials/modal_filtros_vehiculos') %>
<%- include('../partials/modal_editar_vehiculo') %>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
    window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
</script>
<script src="/js/atajos.js"></script>
<script src="/js/accesibilidad.js"></script>

<%- include('../partials/footer', { usuario: usuario }) %>

</body>
</html>