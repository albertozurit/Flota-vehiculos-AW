<table class="table table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Marca</th>
      <th>Modelo</th>
      <th>Matrícula</th>
      <th>Año</th>
      <th>Estado</th>
      <% if (usuario && usuario.rol==='admin' ) { %>
        <th>Acciones</th>
        <% } else { %>
          <th>Reserva</th>
          <% } %>
    </tr>
  </thead>
  <tbody>
    <% (vehiculos || []).forEach(function(vehiculo){ %>
      <tr>
        <td>
          <%= vehiculo.id %>
        </td>
        <td>
          <%= vehiculo.marca %>
        </td>
        <td>
          <%= vehiculo.modelo %>
        </td>
        <td>
          <%= vehiculo.matricula %>
        </td>
        <td>
          <%= vehiculo.anio_matriculacion || '' %>
        </td>
        <td>
          <% if (vehiculo.estado==='disponible' ) { %>
            <span class="badge bg-success">Disponible</span>
            <% } else if (vehiculo.estado==='reservado' ) { %>
              <span class="badge bg-warning">Reservado</span>
              <% } else { %>
                <span class="badge bg-danger">Mantenimiento</span>
                <% } %>
        </td>
        <% if (usuario && usuario.rol==='admin' ) { %>
          <td>
            <a href="/vehiculos/<%= vehiculo.id %>/editar/" class="btn btn-sm btn-warning">Editar</a>
            <form action="/vehiculos/<%= vehiculo.id %>/eliminar" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-danger"
                onclick="return confirm('¿Seguro que quieres eliminar este vehículo?')">Eliminar</button>
            </form>
          </td>
          <% } else { %>
            <td>
              <% if (vehiculo.estado==='disponible' ) { %>
                <button type="button" class="btn btn-sm btn-primary reservar-btn" data-bs-toggle="modal"
                  data-bs-target="#reservarModal" data-id="<%= vehiculo.id %>">
                  Reservar
                </button>
                <% } else { %>
                  <button class="btn btn-sm btn-secondary" disabled>No disponible</button>
                  <% } %>
            </td>
            <% } %>
      </tr>
      <% }); %>

        <% if (!vehiculos || vehiculos.length===0) { %>
          <tr>
            <td colspan="7" class="text-center text-muted">Sin vehículos</td>
          </tr>
          <% } %>
  </tbody>
</table>