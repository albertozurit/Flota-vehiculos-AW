<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <title>Panel de administrador</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" id="theme-link">
</head>

<body class="bg-light">
  <%- include('partials/header', { usuario: usuario }) %>
    <% if (!usuario || usuario.rol !=='admin' ) { %>
      <div class="container py-4">
        <div class="alert alert-danger">No tienes permisos para ver este panel. Se requiere rol
          <strong>admin</strong>.
        </div>
      </div>
      <% } else { %>
        <main class="container py-4">
          <header class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">Panel de administrador</h1>
            <div class="text-muted">Conectado: <strong>
                <%= usuario.nombre || usuario.email %>
              </strong> • Rol: <strong>
                <%= usuario.rol %>
              </strong></div>
          </header>

          <div class="mb-3">
            <button class="btn btn-sm btn-outline-secondary" onclick="history.back()">⟵ Volver</button>
          </div>

          <section class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span>Estadísticas Rápidas</span>
              <div>
                <a class="btn btn-sm btn-outline-primary" href="/admin/carga-json">
                  <i class="bi bi-database-fill-add me-1"></i>Cargar datos (JSON)</a>
              </div>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-3">
                  <div class="p-3 bg-white border rounded">Vehículos: <strong>
                      <%= (stats && stats.vehiculos) || 0 %>
                    </strong></div>
                </div>
                <div class="col-md-3">
                  <div class="p-3 bg-white border rounded">Concesionarios: <strong>
                      <%= (stats && stats.concesionarios) || 0 %>
                    </strong></div>
                </div>
                <div class="col-md-3">
                  <div class="p-3 bg-white border rounded">Usuarios: <strong>
                      <%= (stats && stats.usuarios) || 0 %>
                    </strong></div>
                </div>
                <div class="col-md-3">
                  <div class="p-3 bg-white border rounded">Reservas: <strong>
                      <%= (stats && stats.reservas) || 0 %>
                    </strong></div>
                </div>
              </div>
            </div>
          </section>

          <!-- Estadísticas de Reservas por Concesionario -->
          <section class="card mb-4">
            <div class="card-header">
              <i class="bi bi-bar-chart-fill me-2"></i>Reservas por Concesionario
            </div>
            <div class="card-body">
              <% if (stats && stats.reservasPorConcesionario && stats.reservasPorConcesionario.length> 0) { %>
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>Concesionario</th>
                        <th>Ciudad</th>
                        <th class="text-end">Nº Reservas</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% stats.reservasPorConcesionario.forEach(item=> { %>
                        <tr>
                          <td><%= item.nombre %></td>
                          <td><%= item.ciudad %></td>
                          <td class="text-end"><span class="badge bg-primary"><%= item.num_reservas %></span></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-muted mb-0">No hay reservas registradas aún.</p>
              <% } %>
            </div>
          </section>

          <section class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span>Gestión de vehículos</span>
              <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                data-bs-target="#modalCrearVehiculo"><i class="bi bi-plus-circle"></i> Alta vehículo</button>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-sm table-striped">
                  <thead>
                    <tr>
                      <th>Matrícula</th>
                      <th>Marca</th>
                      <th>Modelo</th>
                      <th>Concesionario</th>
                      <th>Plazas</th>
                      <th>Autonomía</th>
                      <th>Estado</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% ((typeof vehiculos !=='undefined' && Array.isArray(vehiculos)) ? vehiculos : []).forEach(v=> { %>
                      <tr>
                        <td>
                          <%= v.matricula %>
                        </td>
                        <td>
                          <%= v.marca %>
                        </td>
                        <td>
                          <%= v.modelo %>
                        </td>
                        <td>
                          <small class="text-muted">
                            <%= v.concesionario_nombre || '-' %>
                          </small>
                        </td>
                        <td>
                          <%= v.numero_plazas || '' %>
                        </td>
                        <td>
                          <%= v.autonomia_km || '' %>
                        </td>
                        <td><span
                            class="badge bg-<%= v.estado==='disponible'?'success':(v.estado==='reservado'?'warning':'secondary') %>">
                            <%= v.estado %>
                          </span></td>
                        <td class="text-end">
                          <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal"
                            data-bs-target="#modalEditarVehiculo" data-id="<%= v.id %>"
                            data-matricula="<%= v.matricula || '' %>" data-marca="<%= v.marca || '' %>"
                            data-modelo="<%= v.modelo || '' %>" data-anio="<%= v.anio_matriculacion || '' %>"
                            data-plazas="<%= v.numero_plazas || '' %>" data-autonomia="<%= v.autonomia_km || '' %>"
                            data-color="<%= v.color || '' %>" data-estado="<%= v.estado || 'disponible' %>">Editar</button>
                          <form action="/admin/vehiculos/<%= v.id %>/eliminar" method="POST" class="d-inline"
                            onsubmit="return confirm('¿Eliminar/baja lógica?')">
                            <button class="btn btn-sm btn-outline-danger">Baja</button>
                          </form>
                        </td>
                      </tr>
                      <% }) %>
                        <% if (typeof vehiculos==='undefined' || vehiculos.length===0) { %>
                          <tr>
                            <td colspan="7" class="text-center text-muted">Sin vehículos</td>
                          </tr>
                          <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="card mb-4">
            <div class="card-header">Gestión de concesionarios</div>
            <div class="card-body">
              <form action="/admin/concesionarios/nuevo" method="POST" class="row g-2 mb-3">
                <div class="col-md-4"><input class="form-control" name="nombre" placeholder="Nombre" required></div>
                <div class="col-md-3"><input class="form-control" name="ciudad" placeholder="Ciudad"></div>
                <div class="col-md-3"><input class="form-control" name="direccion" placeholder="Dirección">
                </div>
                <div class="col-md-2"><input class="form-control" name="telefono_contacto" placeholder="Teléfono"></div>
                <div class="col-12"><button class="btn btn-success btn-sm">Crear concesionario</button>
                </div>
              </form>

              <div class="table-responsive">
                <table class="table table-sm table-striped">
                  <thead>
                    <tr>
                      <th>Nombre</th>
                      <th>Ciudad</th>
                      <th>Dirección</th>
                      <th>Teléfono</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% ((typeof concesionarios !=='undefined' && Array.isArray(concesionarios)) ? concesionarios :
                      []).forEach(c=> { %>
                      <tr>
                        <td>
                          <%= c.nombre %>
                        </td>
                        <td>
                          <%= c.ciudad || '' %>
                        </td>
                        <td>
                          <%= c.direccion || '' %>
                        </td>
                        <td>
                          <%= c.telefono_contacto || '' %>
                        </td>
                        <td class="text-end">
                          <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal"
                            data-bs-target="#modalEditarConcesionario" data-id="<%= c.id_concesionario || c.id %>"
                            data-nombre="<%= c.nombre || '' %>" data-ciudad="<%= c.ciudad || '' %>"
                            data-direccion="<%= c.direccion || '' %>"
                            data-telefono="<%= c.telefono_contacto || '' %>">Editar</button>
                          <form action="/admin/concesionarios/<%= c.id_concesionario || c.id %>/eliminar" method="POST"
                            class="d-inline" onsubmit="return confirm('¿Eliminar concesionario?')">
                            <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                          </form>
                        </td>
                      </tr>
                      <% }) %>
                        <% if (typeof concesionarios==='undefined' || concesionarios.length===0) { %>
                          <tr>
                            <td colspan="5" class="text-center text-muted">Sin concesionarios
                            </td>
                          </tr>
                          <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <section class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span>Gestión de usuarios</span>
              <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal"
                data-bs-target="#modalCrearUsuario"><i class="bi bi-plus-circle"></i> Crear usuario</button>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-sm table-striped">
                  <thead>
                    <tr>
                      <th>Nombre</th>
                      <th>Email</th>
                      <th>Rol</th>
                      <th>Concesionario</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% ((typeof usuarios !=='undefined' && Array.isArray(usuarios)) ? usuarios : []).forEach(u=> { %>
                      <tr>
                        <td>
                          <%= u.nombre || '-' %>
                        </td>
                        <td>
                          <%= u.correo || u.email %>
                        </td>
                        <td>
                          <span class="badge bg-<%= u.rol === 'admin' ? 'danger' : 'primary' %>">
                            <%= u.rol %>
                          </span>
                        </td>
                        <td>
                          <% if (u.concesionario_nombre) { %>
                            <small class="text-muted">
                              <%= u.concesionario_nombre %>
                            </small>
                            <% } else { %>
                              <small class="text-muted fst-italic">Sin asignar</small>
                              <% } %>
                        </td>
                        <td class="text-end">
                          <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal"
                            data-bs-target="#modalEditarUsuario" data-id="<%= u.id_usuario || u.id %>"
                            data-nombre="<%= u.nombre || '-' %>" data-email="<%= u.correo || u.email %>"
                            data-rol="<%= u.rol %>" data-concesionario-id="<%= u.id_concesionario || '' %>"
                            title="Editar rol y concesionario">
                            Editar
                          </button>
                          <form action="/admin/usuarios/<%= u.id_usuario || u.id %>/eliminar" method="POST"
                            class="d-inline" onsubmit="return confirm('¿Eliminar usuario?')">
                            <button class="btn btn-sm btn-outline-danger" title="Eliminar usuario">Eliminar</button>
                          </form>
                        </td>
                      </tr>
                      <% }) %>
                        <% if (typeof usuarios==='undefined' || usuarios.length===0) { %>
                          <tr>
                            <td colspan="5" class="text-center text-muted">Sin usuarios</td>
                          </tr>
                          <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

        </main>
        <% } %>

          <div class="modal fade" id="modalCrearUsuario" tabindex="-1" aria-labelledby="modalCrearUsuarioLabel"
            aria-hidden="true">
            <div class="modal-dialog">
              <form class="modal-content" method="POST" action="/register">
                <div class="modal-header">
                  <h5 class="modal-title" id="modalCrearUsuarioLabel">Crear usuario</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-2">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" name="nombre" required>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Correo corporativo</label>
                    <input class="form-control" type="email" name="email" placeholder="ejemplo@flotawei.com" required>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Contraseña</label>
                    <input class="form-control" type="password" name="password" minlength="8" required>
                    <small class="text-muted">Mínimo 8 caracteres, 1 mayúscula y 1 número.</small>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Concesionario</label>
                    <select class="form-select" name="id_concesionario" required>
                      <option value="">Seleccione...</option>
                      <% (concesionarios||[]).forEach(function(c){ %>
                        <option value="<%= c.id %>">
                          <%= c.nombre %>
                        </option>
                        <% }) %>
                    </select>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Rol</label>
                    <select class="form-select" name="rol">
                      <option value="empleado" selected>Empleado</option>
                      <option value="admin">Administrador</option>
                    </select>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button class="btn btn-primary">Crear</button>
                </div>
              </form>
            </div>
          </div>

          <div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-labelledby="modalEditarUsuarioLabel"
            aria-hidden="true">
            <div class="modal-dialog">
              <form method="POST" class="modal-content" id="formEditarUsuario">
                <div class="modal-header">
                  <h5 class="modal-title" id="modalEditarUsuarioLabel">Editar usuario: <span id="usuarioNombre"></span>
                  </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  <p class="text-muted">Email: <strong id="usuarioEmail"></strong></p>

                  <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <select class="form-select" name="rol" id="editUsuarioRol">
                      <option value="empleado">Empleado</option>
                      <option value="admin">Administrador</option>
                    </select>
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Concesionario base</label>
                    <select class="form-select" name="id_concesionario" id="editUsuarioConcesionario">
                      <option value="">Sin asignar</option>
                      <% (concesionarios||[]).forEach(function(c){ %>
                        <option value="<%= c.id_concesionario || c.id %>">
                          <%= c.nombre %>
                        </option>
                        <% }) %>
                    </select>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button class="btn btn-primary">Guardar cambios</button>
                </div>
              </form>
            </div>
          </div>


          <div class="modal fade" id="modalEditarConcesionario" tabindex="-1"
            aria-labelledby="modalEditarConcesionarioLabel" aria-hidden="true">
            <div class="modal-dialog">
              <form method="POST" class="modal-content" id="formEditarConcesionario">
                <div class="modal-header">
                  <h5 class="modal-title" id="modalEditarConcesionarioLabel">Editar concesionario</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-2">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" name="nombre" required>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Ciudad</label>
                    <input class="form-control" name="ciudad">
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Dirección</label>
                    <input class="form-control" name="direccion">
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" name="telefono_contacto">
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button class="btn btn-primary">Guardar cambios</button>
                </div>
              </form>
            </div>
          </div>

          <div class="modal fade" id="modalCrearVehiculo" tabindex="-1" aria-labelledby="modalCrearVehiculoLabel"
            aria-hidden="true">
            <div class="modal-dialog">
              <form method="POST" action="/admin/vehiculos/nuevo" class="modal-content" enctype="multipart/form-data" id="formNuevoVehiculo">
                <div class="modal-header">
                  <h5 class="modal-title" id="modalCrearVehiculoLabel">Nuevo vehículo</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                  <div id="errorCrearVehiculo" class="alert alert-danger d-none" role="alert"></div>
                  <div class="row g-2">
                    <div class="col-md-4">
                      <label class="form-label">Matrícula</label>
                      <input class="form-control" name="matricula" maxlength="10" required>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Marca</label>
                      <input class="form-control" name="marca" maxlength="50" required>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Modelo</label>
                      <input class="form-control" name="modelo" maxlength="50" required>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Año</label>
                      <input class="form-control" name="anio_matriculacion" type="number" min="1900" max="2100">
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Plazas</label>
                      <input class="form-control" name="numero_plazas" type="number" min="1" max="9">
                    </div>
                    <div class="col-md-4">
                      <label class="form-label">Autonomía (km)</label>
                      <input class="form-control" name="autonomia_km" type="number" min="1" max="10000">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Color</label>
                      <input class="form-control" name="color" maxlength="30">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Concesionario</label>
                      <select class="form-select" name="id_concesionario" required>
                        <option value="">Seleccione...</option>
                        <% (concesionarios||[]).forEach(function(c){ %>
                          <option value="<%= c.id %>">
                            <%= c.nombre %>
                          </option>
                          <% }) %>
                      </select>
                    </div>
                    <div class="col-12 mt-2">
                      <label class="form-label">Foto del vehículo</label>
                      <input class="form-control" type="file" name="imagen" accept="image/*">
                    </div>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button type="submit" class="btn btn-primary">Crear</button>
                </div>
              </form>
            </div>
          </div>

          <%- include('partials/modal_editar_vehiculo') %>

            <%- include('partials/modal_accesibilidad', { preferencias: preferencias || {} }) %>
              <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
              <script>
                window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
                window.currentUserRole = 'admin';
              </script>
              <script src="/js/atajos.js"></script>
              <script src="/js/accesibilidad.js"></script>
</body>

<script>
  (function () {
    // Script para Modal Editar Concesionario
    const modalCon = document.getElementById('modalEditarConcesionario');
    if (modalCon) {
      modalCon.addEventListener('show.bs.modal', (e) => {
        const btn = e.relatedTarget;
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        const nombre = btn.getAttribute('data-nombre') || '';
        const ciudad = btn.getAttribute('data-ciudad') || '';
        const direccion = btn.getAttribute('data-direccion') || '';
        const telefono = btn.getAttribute('data-telefono') || '';
        const form = document.getElementById('formEditarConcesionario');
        if (!form) return;
        form.action = `/admin/concesionarios/${id}/editar`;
        form.nombre.value = nombre;
        form.ciudad.value = ciudad;
        form.direccion.value = direccion;
        form.telefono_contacto.value = telefono;
      });
    }

    // Script para Modal Editar Usuario (NUEVO)
    const modalUser = document.getElementById('modalEditarUsuario');
    if (modalUser) {
      modalUser.addEventListener('show.bs.modal', (e) => {
        const btn = e.relatedTarget;
        if (!btn) return;

        const id = btn.getAttribute('data-id');
        const nombre = btn.getAttribute('data-nombre') || '';
        const email = btn.getAttribute('data-email') || '';
        const rol = btn.getAttribute('data-rol') || 'empleado';
        const concesionarioId = btn.getAttribute('data-concesionario-id') || '';

        const form = document.getElementById('formEditarUsuario');
        const nombreSpan = document.getElementById('usuarioNombre');
        const emailStrong = document.getElementById('usuarioEmail');
        const selectRol = document.getElementById('editUsuarioRol');
        const selectConcesionario = document.getElementById('editUsuarioConcesionario');

        // 1. Configurar la acción del formulario
        // Asegúrate de que este endpoint sea el correcto en tu servidor para editar roles y concesionarios
        form.action = `/admin/usuarios/${id}/editar`;

        // 2. Rellenar la información visible en el modal
        nombreSpan.textContent = nombre;
        emailStrong.textContent = email;

        // 3. Seleccionar el Rol correcto
        selectRol.value = rol;

        // 4. Seleccionar el Concesionario correcto
        selectConcesionario.value = concesionarioId;
      });
    }

    // Script para validar formulario Crear Vehículo
    const formCrearVehiculo = document.getElementById('formNuevoVehiculo');
    if (formCrearVehiculo) {
      formCrearVehiculo.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errorDiv = document.getElementById('errorCrearVehiculo');
        errorDiv.classList.add('d-none');
        
        const formData = new FormData(formCrearVehiculo);
        
        try {
          const response = await fetch('/admin/vehiculos/nuevo', {
            method: 'POST',
            body: formData
          });
          
          if (response.ok) {
            window.location.reload();
          } else {
            const data = await response.json();
            errorDiv.textContent = data.error || 'Error al crear el vehículo';
            errorDiv.classList.remove('d-none');
          }
        } catch (error) {
          errorDiv.textContent = 'Error de conexión al crear el vehículo';
          errorDiv.classList.remove('d-none');
        }
      });
    }

  })();
</script>

</html>