    <section id="reservas_form">
        <h2>Formulario de reservas</h2>
        <form id="formulario_reserva">
            <fieldset>
                <legend>Solicitud de reserva</legend>
                <label for="vehiculo_form">Elige un vehiculo:</label>
                <select id="vehiculo_form" name="vehiculo_form" required aria-describedby="errorVehiculo">
                    <option value="" disabled selected hidden>Seleccionar...</option>
                    <option value="Coche">Tesla</option>
                    <option value="Patinete">Ford</option>
                    <option value="Moto">Porsche</option>
                </select>
                <span id="errorVehiculo" style="color:red; font-size: small;"></span>

                <label for="duracion"> Duracion de reserva</label>
                <input type="text" id="duracion" name="duracion" required aria-describedby="errorDuracion">
                <span id="errorDuracion" style="color:red; font-size: small;"></span>


                <label for="telefono">Telefono &#40sin espacios&#41</label>
                <input type="tel" name="telefono" id="telefono" pattern="[0-9]{9}">
                <span id="errorTelefono" style="color:red; font-size: small;" aria-live="polite"></span>

                <div class="checkbox">
                    <label for="aceptarCondiciones">Acepto las condiciones</label>
                    <input type="checkbox" id="aceptarCondiciones" name="aceptarCondiciones" required>

                </div>

                <div class="botones-accion">
                    <button type="submit" id="submitForm">Enviar</button>
                    <button type="reset" id="btnLimpiar">Limpiar</button>
                </div>
            </fieldset>
        </form>
    </section>

</main>