    <%- include('../partials/header', { usuario: usuario }) %>
    <section id="reservas_form" class="p-2">
        <h2 class="h3 mb-3">Formulario de reservas</h2>

        <form id="formulario_reserva" method="POST" action="/reservas/guardar">
            <% if (typeof vehiculo !== 'undefined' && vehiculo) { %>
                <div class="mb-3">
                    <label class="form-label">Vehículo seleccionado</label>
                    <div class="p-3 bg-light rounded">
                        <strong class="d-block"><%= vehiculo.marca %> <%= vehiculo.modelo %></strong>
                        <small class="text-muted">Matrícula: <%= vehiculo.matricula || '—' %> • Año: <%= vehiculo.anio_matriculacion || '—' %></small>
                    </div>
                    <input type="hidden" name="vehiculoId" value="<%= vehiculo.id %>">
                </div>
            <% } else { %>
                <div class="mb-3">
                    <label for="vehiculo_form" class="form-label">Elige un vehículo</label>
                    <select id="vehiculo_form" name="vehiculoId" class="form-select" required aria-describedby="errorVehiculo">
                        <option value="" disabled selected hidden>Seleccionar...</option>
                        <option value="1">Tesla</option>
                        <option value="2">Ford</option>
                        <option value="3">Porsche</option>
                    </select>
                    <div id="errorVehiculo" class="form-text text-danger small"></div>
                </div>
            <% } %>

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label for="fechaInicio" class="form-label">Fecha inicio</label>
                    <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" required>
                </div>
                <div class="col-md-2">
                    <label for="horaInicio" class="form-label">Hora inicio</label>
                    <input type="time" id="horaInicio" name="horaInicio" class="form-control" required>
                </div>
                <div class="col-md-3">
                    <label for="fechaFin" class="form-label">Fecha fin</label>
                    <input type="date" id="fechaFin" name="fechaFin" class="form-control" required>
                </div>
                <div class="col-md-2">
                    <label for="horaFin" class="form-label">Hora fin</label>
                    <input type="time" id="horaFin" name="horaFin" class="form-control" required>
                </div>
            </div>

            <div class="mb-3 row">
                <label for="telefono" class="col-form-label col-sm-3">Teléfono (sin espacios)</label>
                <div class="col-sm-4">
                    <input type="tel" name="telefono" id="telefono" pattern="[0-9]{9}" class="form-control">
                    <div id="errorTelefono" class="form-text text-danger small" aria-live="polite"></div>
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="aceptarCondiciones" name="aceptarCondiciones" required>
                <label class="form-check-label" for="aceptarCondiciones">Acepto las condiciones</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" id="submitForm">Enviar</button>
                <button type="reset" class="btn btn-outline-secondary" id="btnLimpiar">Limpiar</button>
            </div>
        </form>
    </section>

</main>