<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head.ejs') %>
        <title>
            <%= title %>
        </title>
</head>

<body>

    <%- include('../partials/header', { usuario: usuario }) %>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-12">
                    <h2 class="h3 mb-4 page-title"><i class="fas fa-list-alt me-2"></i>Mis Reservas de Vehículos</h2>

                    <% if (mensaje) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <%= mensaje %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                        <% } %>

                            <% if (reservas && reservas.length> 0) { %>
                                <div class="table-responsive shadow-sm rounded">
                                    <table class="table table-hover align-middle">
                                        <thead class="bg-primary text-white">
                                            <tr>
                                                <th># Reserva</th>
                                                <th>Vehículo</th>
                                                <th>Matrícula</th>
                                                <th>Inicio</th>
                                                <th>Fin</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% reservas.forEach(reserva=> { %>
                                                <tr>
                                                    <td>
                                                        <%= reserva.id %>
                                                    </td>
                                                    <td>
                                                        <%= reserva.vehiculo %>
                                                    </td>
                                                    <td>
                                                        <%= reserva.matricula %>
                                                    </td>
                                                    <td>
                                                        <%= reserva.inicio %>
                                                    </td>
                                                    <td>
                                                        <%= reserva.fin %>
                                                    </td>
                                                    <td>
                                                        <% if (reserva.estado==='confirmada' ) { %>
                                                            <span class="badge bg-success">Activa</span>
                                                        <% } else if (reserva.estado==='finalizada' ) { %>
                                                            <span class="badge bg-secondary">Finalizada</span>
                                                        <% } else if (reserva.estado==='Cancelada' ) { %>
                                                            <span class="badge bg-danger">Cancelada</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark"><%= reserva.estado %></span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <% if (reserva.estado==='confirmada' ) { %>
                                                        <form action="/reservas/cancelar/<%= reserva.id %>"
                                                            method="POST" style="display:inline;">
                                                            <button type="submit" class="btn btn-sm btn-danger"
                                                                onclick="return confirm('¿Estás seguro de que quieres cancelar esta reserva?')">
                                                                Cancelar
                                                            </button>
                                                        </form>
                                                        <% } else { %>
                                                            <span class="text-muted">-</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>

                                </div>
                                <% } else { %>
                                    <div class="alert alert-info" role="alert">
                                        Aún no tienes reservas activas. <a href="/reservas/nuevo"
                                            class="alert-link">¡Haz
                                            una reserva ahora!</a>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </div>

        <%- include('../partials/footer.ejs') %>
</body>

</html>