<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <title>Carga inicial desde JSON</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" id="theme-link">
  <link rel="icon" type="image/png" href="/images/LogoRuedaVentana.png">
</head>

<body class="bg-light">
  <%- include('../partials/header', { usuario: usuario }) %>

    <main class="container mt-5 pt-5">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
              <h1 class="h4 mb-0"><i class="bi bi-database-fill-add me-2"></i>Carga inicial desde JSON</h1>
            </div>
            <div class="card-body p-4">
              <% if (mensaje) { %>
                <div class="alert alert-<%= tipo || 'info' %> alert-dismissible fade show" role="alert">
                  <%= mensaje %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                  <div class="mb-4">
                    <h5><i class="bi bi-info-circle me-2"></i>Información</h5>
                    <ul class="text-muted">
                      <li>Se cargará desde el archivo <code>bd_vacia.json</code> en la raíz del proyecto</li>
                      <li><strong><i class="bi bi-exclamation-triangle me-1"></i>Importante:</strong> La base de datos
                        debe estar vacía (0 vehículos y 0 concesionarios)</li>
                      <li>Se insertarán concesionarios primero, luego los vehículos</li>
                    </ul>
                  </div>

                  <div class="d-flex gap-2 flex-wrap">
                    <form method="POST" action="/admin/carga-json" class="d-inline">
                      <button class="btn btn-primary" type="submit">
                        <i class="bi bi-cloud-upload me-1"></i>Cargar datos
                      </button>
                    </form>
                    <form method="POST" action="/admin/vaciar-bd" class="d-inline"
                      onsubmit="return confirm('¿Estás seguro? Esto eliminará TODOS los datos (vehículos, concesionarios, reservas). Los usuarios se mantendrán.')">
                      <button class="btn btn-warning" type="submit">
                        <i class="bi bi-trash me-1"></i>Vaciar BD
                      </button>
                    </form>
                    <a class="btn btn-outline-secondary" href="/admin">
                      <i class="bi bi-arrow-left me-1"></i>Volver al panel
                    </a>
                  </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
      window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
    </script>
    <script src="/js/atajos.js"></script>
    <script src="/js/accesibilidad.js"></script>

    <%- include('../partials/footer', { usuario: usuario }) %>

</body>

</html>