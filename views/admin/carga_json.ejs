<main class="container py-3">
  <h1 class="h3">Carga inicial desde JSON</h1>
  <% if (mensaje) { %><div class="alert alert-info"><%= mensaje %></div><% } %>
  <p class="text-muted">Se cargará desde el archivo bd_vacia.json en la raíz del proyecto. Requiere BD vacía.</p>
  <form method="POST" action="/admin/carga-json">
    <button class="btn btn-primary" type="submit">Cargar desde bd_vacia.json</button>
    <a class="btn btn-secondary" href="/admin/concesionarios">Volver</a>
  </form>
</main>
