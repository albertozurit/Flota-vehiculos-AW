<%- include('../partials/head', { title: 'Nuevo Concesionario' }) %>

  <body>
    <%- include('../partials/header', { usuario: usuario }) %>

      <main class="container mt-5 pt-3">
        <div class="row justify-content-center">
          <div class="col-md-8">
            <div class="card shadow-sm">
              <div class="card-header bg-primary text-white">
                <h1 class="h4 mb-0">🏢 Nuevo Concesionario</h1>
              </div>
              <div class="card-body p-4">
                <% if (mensaje) { %>
                  <div class="alert alert-warning">
                    <%= mensaje %>
                  </div>
                  <% } %>

                    <form method="POST" action="/admin/concesionarios/nuevo" class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input name="nombre" class="form-control" required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Ciudad</label>
                        <input name="ciudad" class="form-control">
                      </div>
                      <div class="col-12">
                        <label class="form-label">Dirección</label>
                        <input name="direccion" class="form-control">
                      </div>
                      <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input name="telefono_contacto" class="form-control">
                      </div>
                      <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> Guardar</button>
                        <a class="btn btn-secondary" href="/admin/concesionarios"><i class="bi bi-x-circle"></i>
                          Cancelar</a>
                      </div>
                    </form>
              </div>
            </div>
          </div>
        </div>
      </main>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
      <script>
        window.appShortcuts = (typeof preferencias !== 'undefined' && preferencias.atajos) ? preferencias.atajos : {};
        window.currentUserRole = "<%= usuario ? usuario.rol : '' %>";
      </script>
      <script src="/js/atajos.js"></script>
      <script src="/js/accesibilidad.js"></script>

      <%- include('../partials/footer', { usuario: usuario }) %>

  </body>

  </html>